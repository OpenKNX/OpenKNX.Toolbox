<Page x:Class="OpenKNX.Toolbox.Pages.ActionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenKNX.Toolbox.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:properties="clr-namespace:OpenKNX.Toolbox.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ActionsPage">


    <TabControl>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="XboxConsole24" />
                    <TextBlock Text="{x:Static properties:Resources.PendingActions}" />
                    <ui:InfoBadge Value="{Binding Actions.Count}" Margin="5,0,0,0" />
                </StackPanel>
            </TabItem.Header>
            
            <ui:ListView ItemsSource="{Binding Actions}" DisplayMemberPath="Name" />
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="XboxConsole24" />
                    <TextBlock Text="{x:Static properties:Resources.History}" />
                    <ui:InfoBadge Value="{Binding History.Count}" Margin="5,0,0,0" />
                </StackPanel>
            </TabItem.Header>

            <ui:ListView ItemsSource="{Binding History}" DisplayMemberPath="Action.ActionName" />
        </TabItem>
    </TabControl>
</Page>
