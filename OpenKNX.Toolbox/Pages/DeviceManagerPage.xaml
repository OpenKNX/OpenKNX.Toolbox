<Page x:Class="OpenKNX.Toolbox.Pages.DeviceManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenKNX.Toolbox.Pages"
      xmlns:vm="clr-namespace:OpenKNX.Toolbox.ViewModels"
      xmlns:models="clr-namespace:OpenKNX.Toolbox.Models"
      xmlns:libmodels="clr-namespace:OpenKNX.Toolbox.Lib.Models;assembly=OpenKNX.Toolbox.Lib"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:OpenKNX.Toolbox.Converter"
      xmlns:properties="clr-namespace:OpenKNX.Toolbox.Properties"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DeviceManagerPage">
    <Page.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Foreground="{DynamicResource ResourceKey=TextFillColorPrimaryBrush}" Margin="10,5" Text="{x:Static properties:Resources.DeviceListIntro}" />

        <!--<Menu Foreground="White">
            --><!--<ui:MenuItem Header="Aktualisieren" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Command="{Binding Update}" />--><!--
            <ui:MenuItem Header="Hinzufügen" Icon="{ui:SymbolIcon Symbol=Add24}" />
        </Menu>-->

        <ui:ListView Grid.Row="1" ItemsSource="{Binding DeviceModels}" SelectedItem="{Binding SelectedDevice}">
            <ui:ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:DeviceModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.ContextMenu>
                            <ContextMenu>
                                <ui:MenuItem Header="{x:Static properties:Resources.OpenWebsite}" Command="{Binding DoOpenWebsiteCommand}" Visibility="{Binding IsIP, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Globe24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Header="{x:Static properties:Resources.Refresh}" Command="{Binding DoUpdateCommand}" Foreground="Green" Visibility="{Binding UpdateVersion, Converter={StaticResource NullToVisibilityConverter}}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowExportUp24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Image Source="{Binding ImageUrl}" Width="100" Height="100" Margin="5,5,15,5"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Margin="0,5,0,10" />
                            <TextBlock>
                                <Run Text="{Binding Address}" />
                                <Run Text="{Binding IP}" />
                                    </TextBlock>
                                    <TextBlock>
                                <Run Text="{Binding FirmwareName}" />
                                <Run Text="[" />
                                <Run Text="{Binding AppId}" />
                                <Run Text="]" />
                                <Run Text="{Binding FirmwareVersionString}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SerialNumber}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Visibility="{Binding UpdateVersion, Converter={StaticResource NullToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Static properties:Resources.UpdateAvailable}" FontWeight="Bold" Foreground="Green" FontSize="20" />
                            <TextBlock Text="{Binding UpdateVersionString}" Foreground="Green" TextAlignment="Right" FontSize="20" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>
